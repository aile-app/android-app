!gradle/wrapper/gradle-wrapper.properties
!gradlew
!gradlew.bat

# NOTE: app/build/ is ignored by the /build/ pattern above
# The following .idea/ files are intentionally kept in repo for project sharing:
# - .idea/.gitignore
# - .idea/.name
# - .idea/AndroidProjectSystem.xml
# - .idea/compiler.xml
# - .idea/gradle.xml
# - .idea/markdown.xml
# - .idea/migrations.xml
# - .idea/runConfigurations.xml
# - .idea/vcs.xml
# - These should be the ONLY .idea/ files committed